{
  "manifest_version": 3,
  "name": "Descargador de Capítulos",
  "version": "1.0",
  "description": "Download chapters in Markdown from the current page.",
  "permissions": ["downloads", "activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://novelarrow.com/chapter/*"],
      "js": [
        "utils/helpers.js",
        "content/storage.js",
        "content/state.js",
        "content/ui.js",
        "content/selectors.js",
        "content/page.js",
        "content/navigation.js",
        "content/index.js"
      ]
    }
  ]
}
